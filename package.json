{
  "name": "inspiration-manager",
  "productName": "灵感管理",
  "version": "0.1.0",
  "description": "灵感管理软件：记录灵感，孵化计划、方案、项目",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "license": "MIT",
  "private": true,
  "build": {
    "appId": "com.vibecoding.inspiration",
    "productName": "灵感管理",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": true,
      "artifactName": "灵感管理-${version}-安装版.exe"
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
